  "purpose": "Separate observable image-action consistency from visual measurement coverage without changing the frozen visual reader, acceptance rules, or historical v1.1 results.",
  "definitions": {
    "AS_progress_conditional_micro": "accepted progress intervals / quality-scored progress intervals",
    "AS_progress_score_coverage": "quality-scored progress intervals / all expected progress intervals",
    "AS_yaw_conditional": "correct yaw events / visually scored applicable yaw events",
    "AS_yaw_score_coverage": "visually scored applicable yaw events / all applicable yaw events",
    "AS_conditional": "sqrt(AS_progress_conditional_micro * AS_yaw_conditional)",
    "AS_observability": "sqrt(AS_progress_score_coverage * AS_yaw_score_coverage)",
    "AS_deployment": "AS_conditional * AS_observability"
  },
