{
  "protocol": "iac-future-to-action-mediation-v1",
  "status": "design_defined_not_run",
  "purpose": "Test whether a WAM native action changes when only its predicted future is perturbed, and whether blocking that pathway suppresses the change.",
  "required_conditions": [
    "baseline",
    "future_perturbed",
    "future_perturbed_pathway_blocked",
    "future_fixed_action_pathway_control"
  ],
  "invariance_contract": [
    "same_source_key",
    "same_history",
    "same_command",
    "same_nuisance_seed",
    "same_model_revision"
  ],
  "action_normalization_contract": {
    "required_fields": [
      "action_normalization_fingerprint",
      "action_normalization_scale"
    ],
    "source": "calibration_sources_only",
    "freeze_before_confirmation": true,
    "same_across_conditions": true,
    "positive_finite_scale_per_action_dimension": true,
    "reason": "Raw action-coordinate norms are not comparable across interventions or model adapters."
  },
  "intervention_identity_contract": {
    "required_fields": ["future_fingerprint", "pathway_state"],
    "future_fingerprint_relationship": {
      "baseline_equals_future_fixed_action_pathway_control": true,
      "future_perturbed_equals_future_perturbed_pathway_blocked": true,
      "baseline_differs_from_future_perturbed": true
    },
    "pathway_state_by_condition": {
      "baseline": "normal",
      "future_perturbed": "normal",
      "future_perturbed_pathway_blocked": "blocked",
      "future_fixed_action_pathway_control": "fixed_action"
    }
  },
  "estimands": {
    "future_effect_on_action": "distance(native_action_future_perturbed, native_action_baseline)",
    "blocked_effect_on_action": "distance(native_action_future_perturbed_pathway_blocked, native_action_baseline)",
    "pathway_suppression": "1 - blocked_effect_on_action / future_effect_on_action",
    "specificity_control": "distance(native_action_future_fixed_action_pathway_control, native_action_baseline)"
  },
  "distance": {
    "representation": "candidate-independent native action vector",
    "normalization": "fit on calibration sources only, then freeze",
    "minimum_future_effect": 0.05,
    "minimum_sources": 30
  },
  "confirmation_split_contract": {
    "calibration_source_manifest_required_for_promotion": true,
    "confirmation_source_keys_must_be_disjoint": true,
    "missing_manifest_policy": "insufficient_evidence"
  },
  "promotion_criteria": {
    "minimum_sources": 30,
    "future_effect_ci95_lower_min": 0.05,
    "pathway_suppression_ci95_lower_min": 0.5,
    "specificity_control_ci95_upper_max": 0.25,
    "confirmation_must_be_source_disjoint": true
  },
  "missing_value_policy": "unavailable_never_zero_fill",
  "claim_boundary": "A passed mediation test supports future-to-action dependence for the tested pathway and intervention; MAS/RCS consistency alone is not mediation evidence."
}
