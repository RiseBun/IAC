{
  "protocol": "iac-wam-three-metric-v1",
  "status": "implemented_pilot_validation_pending",
  "canonical_metrics": {
    "motion_alignment_score": {
      "id": "MAS",
      "legacy_alias": "CFAC",
      "definition": "single-branch candidate-blind visual structure aligned with the native action",
      "required_inputs": ["generated_future_video", "native_action", "camera_calibration"],
      "current_status": "implemented; structural calibration pending"
    },
    "response_consistency_score": {
      "id": "RCS",
      "legacy_alias": "CCFC",
      "definition": "same-source intervention difference in video aligned with intervention difference in action",
      "required_inputs": ["left_future_video", "right_future_video", "left_action", "right_action", "shared_history", "controls"],
      "current_status": "implemented; scene-disjoint promotion validation pending"
    },
    "grounding_score": {
      "id": "GS",
      "legacy_components": ["FAU_F", "FAU_A", "FAU"],
      "definition": "generated visual future and native action grounded against an external logged or simulated future",
      "required_inputs": ["generated_future_video", "native_action", "external_future_reference"],
      "current_status": "cross-model candidate validated; formal release pending final protocol freeze",
      "candidate_freeze_status": "source_disjoint_calibration_and_cluster_bootstrap_validated",
      "candidate_aggregation": {
        "implementation": "iac_new.visual_consistency.score_structural_grounding",
        "descriptors": ["median_flow_magnitude_px", "horizontal_flow_center", "vertical_flow_center", "divergence", "curl"],
        "magnitude_transform": "log1p",
        "similarity": "exp(-absolute_calibrated_difference)",
        "interval_aggregation": "median",
        "branch_aggregation": "median",
        "minimum_common_intervals": 3,
        "minimum_descriptors_per_interval": 3,
        "missing_policy": "unavailable_never_zero_fill",
        "scale_source": "real_logged_navsim_calibration_only"
      },
      "promotion_evidence": {
        "source_disjoint_generated_calibration": "reports/grounding_score_generated_calibration_validation_20260912.json",
        "confirmation_bootstrap": "reports/grounding_score_bootstrap_20260912.json",
        "criteria": {
          "calibration_coverage_min": 0.90,
          "confirmation_coverage_min": 0.90,
          "minimum_distinguishable_models": 2,
          "cluster_bootstrap_model_difference_ci_excludes_zero": true
        }
      },
      "pilot_evidence": {
        "models": ["Epona", "DriveWAM"],
        "same_source_logged_future_join": true,
        "artifacts": [
          "reports/grounding_score_epona_confirmation_20260911.json",
          "reports/grounding_score_drivewam_confirmation_20260911.json",
          "reports/grounding_score_identity_shuffle_20260911.json"
        ],
        "claim_boundary": "Pilot evidence measures external future grounding; it does not establish future-to-action causality and is not yet a frozen scalar GS."
      }
    }
  },
  "missing_value_policy": "unavailable_or_abstain_never_zero_fill",
  "causal_boundary": "MAS/RCS establish consistency or response matching; neither alone proves future-to-action mediation.",
  "compatibility": {"preserve_legacy_output_keys": true}
}
